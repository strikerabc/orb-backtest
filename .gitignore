# data cache — large parquet files, never commit
data/
outputs/
runs/

# credentials — NEVER commit
.env
*.env
secrets.py
*_api_key*
# The patterns above miss the obvious case: *_api_key* requires the literal
# substring "api_key", so a file named databento_key.txt is NOT ignored. A live
# Databento credential sat in the working tree unignored, one `git add -A` away
# from being committed. Broadened to the conventional key/token/credential names.
*_key.txt
*_key.json
*_secret*
*_token.txt
*.key
*.pem
credentials.json
databento_key.txt

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Local implementation review
IMPROVEMENTS.md
