# data cache — large parquet files, never commit
data/*
outputs/
runs/

# ...but the event calendar is a VERSIONED input, not a cache.
# A p-value computed against a calendar that shifts between runs is not a p-value.
!data/events/

# credentials — NEVER commit
.env
*.env
secrets.py
*_api_key*
databento_key.txt

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Local implementation review
IMPROVEMENTS.md

# NOTE: EVENT_REGIME_PLAN.md is deliberately TRACKED on the
# hypothesis/event-regime-conditioning branch. A pre-registered hypothesis whose
# specification is not in version control cannot be audited after the fact.
