# Gitignore for ORB Backtest System

# Secrets and credentials
.env
.env.local
*.key
*.pem
credentials.json
secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Logs
logs/
*.log

# Trading data
data/cache/
*.db
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Temporary files
*.tmp
*.bak
temp/
tmp/

# Output files (keep structure, ignore data)
outputs/*
runs/*
!outputs/README.md
!outputs/.gitkeep

# Historical market data (large files, regenerable via databento)
data/*.parquet
data/*.csv
data/*.json
data/_backup_*/
data/spreads/
!data/README.md
!data/.gitkeep
