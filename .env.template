# AlphaFunded TradeLocker Credentials Template
# Copy this to .env and fill in your actual credentials
# NEVER commit .env to git - it's already in .gitignore

# TradeLocker Account Details
TRADELOCKER_SERVER=
TRADELOCKER_ACCOUNT_ID=
TRADELOCKER_USERNAME=
TRADELOCKER_PASSWORD=
TRADELOCKER_ACCOUNT_TYPE=demo  # or 'live'

# Account Information
ACCOUNT_SIZE=10000
MAX_DAILY_LOSS=500  # 5% daily loss limit for prop firm
MAX_TOTAL_DRAWDOWN=800  # 8% total drawdown limit (adjust based on your rules)
MAX_POSITION_SIZE=250000  # Maximum notional exposure in USD (25x leverage on $10k)

# Risk Settings
RISK_PER_TRADE_PCT=1.0  # 1% risk per trade ($100 on $10k account)
ENABLE_REGIME_ADAPTIVE=true  # Use 0.75x/1.0x ATR switching based on volatility
ENABLE_CORRELATION_SCALING=true  # Scale down risk for correlated positions

# Contract Specifications (TradeLocker - AlphaFunded)
INSTRUMENT_NAS100=NAS100
INSTRUMENT_NAS100_MINI=NAS100.mini
NAS100_MULTIPLIER=100  # 100 bundles per lot (e.g., 0.05 lot = 5 bundles)
NAS100_MINI_MULTIPLIER=1  # 1 bundle per lot (e.g., 5 lots = 5 bundles)
NAS100_COMMISSION=8.0  # $8 per NAS100 lot
NAS100_MINI_COMMISSION=8.0  # $8 per NAS100.mini lot
MAX_LEVERAGE_INDICES=25  # 25x leverage for indices

# Trading Hours (UTC)
# New York session: 14:30-21:00 UTC (9:30am-4pm ET)
NY_SESSION_START_UTC=14:30
NY_SESSION_END_UTC=21:00

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_system.log
